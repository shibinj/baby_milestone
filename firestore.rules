rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each user can only check their OWN allowlist entry — not enumerate others.
    // No one can write to the allowlist from the app — manage it in the Firebase Console.
    match /allowedUsers/{email} {
      allow get:    if request.auth != null && request.auth.token.email == email;
      allow list, write: if false;
    }

    // Each user can only read and write their own data.
    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId
                         && exists(/databases/$(database)/documents/allowedUsers/$(request.auth.token.email));
    }
  }
}
