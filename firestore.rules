rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helpers
    function isAllowed() {
      return request.auth != null
        && exists(/databases/$(database)/documents/allowedUsers/$(request.auth.token.email));
    }

    function isAdmin() {
      return isAllowed()
        && get(/databases/$(database)/documents/allowedUsers/$(request.auth.token.email)).data.role == 'admin';
    }

    // Allowlist — admins can list to discover roles; others can only check their own entry.
    // Writes are always blocked from the app; manage via Firebase Console.
    match /allowedUsers/{email} {
      allow get:  if request.auth != null && (request.auth.token.email == email || isAdmin());
      allow list: if isAdmin();
      allow write: if false;
    }

    // Per-user data.
    //   Entry users: full read/write on their own doc only.
    //   Admins:      read all docs; write only their own.
    //   ownerEmail must match the authenticated identity — prevents attribution forgery.
    match /users/{userId} {
      allow read:  if isAdmin() || (isAllowed() && request.auth.uid == userId);
      allow write: if isAllowed()
                    && request.auth.uid == userId
                    && request.resource.data.ownerEmail == request.auth.token.email;
    }
  }
}