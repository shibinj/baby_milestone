rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only signed-in users can check if they are on the allowlist.
    // No one can write to the allowlist from the app — manage it in the Firebase Console.
    match /allowedUsers/{email} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Each user can only read and write their own data.
    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId
                         && exists(/databases/$(database)/documents/allowedUsers/$(request.auth.token.email));
    }
  }
}
